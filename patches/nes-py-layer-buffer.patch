@@ -365,6 +365,31 @@ class ShouldReadAndWriteMemory(TestCase):
             env.close()
 
 
+class ShouldExposePixelLayers(TestCase):
+    def test(self):
+        env = create_smb1_instance()
+        try:
+            env.reset()
+            for _ in range(90):
+                env.step(8)
+                env.step(0)
+            for _ in range(120):
+                env.step(0)
+            layers = env.layers
+            self.assertEqual(SCREEN_SHAPE_24_BIT[:2], layers.shape)
+            self.assertEqual(np.uint8, layers.dtype)
+            self.assertEqual({0, 1, 2}, set(np.unique(layers)))
+            # the backdrop is the one universal background color
+            backdrop = env.screen[layers == 0]
+            self.assertTrue((backdrop == backdrop[0]).all())
+            # Mario is the only sprite in front of the background
+            rows, columns = np.nonzero(layers == 2)
+            self.assertLessEqual(rows.max() - rows.min(), 16)
+            self.assertLessEqual(columns.max() - columns.min(), 16)
+        finally:
+            env.close()
+
+
 class ShouldResetAndCloseEnv(TestCase):
